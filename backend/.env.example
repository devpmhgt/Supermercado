# Cadena de conexión de Supabase:
#   Project Settings > Database > Connection string > "Session pooler" (puerto 5432)
#   Reemplaza [YOUR-PASSWORD] por la contraseña de la base de datos.

DATABASE_URL=postgresql://postgres:TU_PASSWORD@db.TU_PROYECTO.supabase.co:5432/postgres
# Clave para firmar los tokens JWT (cualquier texto largo y aleatorio)
JWT_SECRET=cambia-esta-clave-por-una-larga-y-aleatoria
JWT_EXPIRE_MINUTES=480

# Orígenes permitidos (frontend Angular), separados por coma
CORS_ORIGINS=http://localhost:4200

# Máximo de conexiones simultáneas a la base de datos
DB_POOL_MAX=5
